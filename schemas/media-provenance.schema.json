{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitedolympicsports.store/schemas/media-provenance.schema.json",
  "title": "United Olympics Sports media provenance manifest",
  "type": "object",
  "required": ["version", "policy", "baselineTrees", "assets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "policy": {
      "type": "object",
      "required": ["protectedRoots", "allowedApprovalStatus", "baselineMeaning", "newOrModifiedAssetRule"],
      "additionalProperties": false,
      "properties": {
        "protectedRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedApprovalStatus": { "const": "approved" },
        "baselineMeaning": { "type": "string", "minLength": 1 },
        "newOrModifiedAssetRule": { "type": "string", "minLength": 1 }
      }
    },
    "baselineTrees": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "rightsBasis", "source", "approvedBy", "approvedAt", "evidence"],
        "additionalProperties": false,
        "properties": {
          "status": { "const": "approved" },
          "rightsBasis": {
            "enum": ["owner-supplied", "commissioned", "licensed", "public-domain", "generated", "other-documented"]
          },
          "source": { "type": "string", "minLength": 1 },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
