{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/v1/health", "destination": "/api/index?route=health" },
    { "source": "/api/v1/admin/whoami", "destination": "/api/index?route=admin-whoami" },
    { "source": "/api/v1/portal/whoami", "destination": "/api/index?route=portal-whoami" },
    { "source": "/api/v1/requests/sports", "destination": "/api/index?route=sport-request" },
    { "source": "/api/v1/catalog", "destination": "/api/index?route=catalog" },
    { "source": "/auth/session", "destination": "/api/index?route=auth-session" },
    { "source": "/auth/revoke", "destination": "/api/index?route=auth-revoke" },
    { "source": "/public/enquiries", "destination": "/api/index?route=public-enquiries" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
