# Client / optional AI configuration (deferred: assistant currently answers
# verified static product information locally; no browser AI secret is used).
GEMINI_API_KEY=
SUPPORT_EMAIL=Knouxio@gmail.com

# Supabase Auth — browser-safe public configuration only.
# Never place service_role, sb_secret_*, database passwords, or other privileged keys in VITE_* variables.
VITE_SUPABASE_URL=https://olmbezzzqavgjwydlfey.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BU7Yk24M8ClMH_w1XL8Wgw_zSMbaXEA
# Optional server aliases. These are still public verification values, not privileged credentials.
SUPABASE_URL=https://olmbezzzqavgjwydlfey.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_BU7Yk24M8ClMH_w1XL8Wgw_zSMbaXEA

# Production data service — configure DATABASE_URL OR the SQL_* fields.
# This server-side connection is the authority for app_user_roles/app_user_scopes.
DATABASE_URL=
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
# Optional administrative credentials for migration runs (drizzle.config).
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_POOL_MAX=10
SQL_SSL=true
SQL_SSL_REJECT_UNAUTHORIZED=true

# Distributed rate limiting (serverless).
# Current repository runtime truth: shared Redis/Upstash transport is not yet
# implemented/verified; these variables are reserved for the future adapter.
# The server currently falls back to a per-instance memory limiter and readiness
# reports PARTIAL even if one of these URLs is present. Do not claim distributed
# enforcement until the shared adapter is implemented and verified.
REDIS_URL=
UPSTASH_REDIS_REST_URL=

# Firebase fallback verification / administrative actions.
FIREBASE_PROJECT_ID=gen-lang-client-0715083591
# Keep the JSON secret in the deployment environment. Never commit a service-account value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS may be used in environments that provide a mounted credential file.
GOOGLE_APPLICATION_CREDENTIALS=

# Deferred integrations. Leave empty until the provider and sandbox/webhook proof are complete.
# Payments: Stripe activation requires the server secret + signed webhook secret
# and the browser-safe publishable key. The publishable key may be returned by
# /api/v1/payments/config; secret/webhook values never leave the server.
PAYMENTS_PROVIDER=
PAYMENTS_PUBLISHABLE_KEY=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
# Phone OTP: proxied through Supabase Auth SMS (no service-role key needed;
# the proxy enforces E.164, honeypot, strict rate limits and audit).
# Requires the SMS provider to be enabled on the Supabase project itself.
SMS_PROVIDER=
