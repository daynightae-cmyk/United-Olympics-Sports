# Client / optional AI configuration
GEMINI_API_KEY=
SUPPORT_EMAIL=Knouxio@gmail.com

# Production data service — configure DATABASE_URL OR the SQL_* fields.
DATABASE_URL=
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_POOL_MAX=10
SQL_SSL=true
SQL_SSL_REJECT_UNAUTHORIZED=true

# Firebase server verification / administrative actions.
FIREBASE_PROJECT_ID=gen-lang-client-0715083591
# Keep the JSON secret in the deployment environment. Never commit a service-account value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS may be used in environments that provide a mounted credential file.
GOOGLE_APPLICATION_CREDENTIALS=

# Deferred integrations. Leave empty until the provider and sandbox/webhook proof are complete.
PAYMENTS_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=
SMS_PROVIDER=
